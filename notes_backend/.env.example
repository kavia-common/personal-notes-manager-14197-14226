# Notes Backend configuration

# API metadata
API_TITLE=Notes API
API_DESCRIPTION=A FastAPI backend providing CRUD operations for personal notes.
API_VERSION=1.0.0

# CORS configuration
# Comma separated list or "*" to allow all
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Database configuration
# Default uses local SQLite file notes.db at project root.
# For Postgres: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./notes.db
DB_ECHO=false
